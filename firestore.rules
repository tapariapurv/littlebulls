rules_version='2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // A game is found by its code; only its host can list or delete it, so codes can't be browsed.
    match /games/{code} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.host == request.auth.uid;
      allow create: if request.auth != null && code.matches('[A-Z2-9]{6}')
        && request.resource.data.keys().hasOnly(['code', 'name', 'host', 'hostName', 'start', 'exchange', 'fee', 'ends', 'createdAt'])
        && request.resource.data.code == code && request.resource.data.host == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.start is number && request.resource.data.start > 0 && request.resource.data.start <= 1000000000
        && request.resource.data.fee is number && request.resource.data.ends is number;
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;

      // ponytail: players report their own holdings, so a determined player could fake a score.
      // Fine for learning; real prizes would need trades checked on a server.
      match /players/{uid} {
        function game() { return get(/databases/$(db)/documents/games/$(code)).data; }
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && (game().ends == 0 || request.time.toMillis() < game().ends)
          && request.resource.data.keys().hasOnly(['name', 'start', 'balance', 'positions', 'at'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
          && request.resource.data.start == game().start
          && request.resource.data.balance is number && request.resource.data.positions is map;
        allow delete: if request.auth != null && (request.auth.uid == uid || game().host == request.auth.uid);
      }
    }
  }
}
